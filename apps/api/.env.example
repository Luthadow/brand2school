PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://brand2school:brand2school@localhost:5432/brand2school?schema=public"
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
WEB_APP_URL=http://localhost:3000
# Admin portal — password reset links for SUPER_ADMIN / ADMIN_STAFF users
ADMIN_WEB_APP_URL=http://localhost:3001
# Public base URL for uploaded assets (brand logos). Production: https://api.brand2school.co.za
# Production: https://api.brand2school.co.za (required for homepage/partner logos)
API_PUBLIC_URL=http://localhost:4000
# Public contact (displayed on site; see apps/web/lib/contact.ts)
# schools@ | brands@ | info@ | admin@brand2school.co.za
INTERNAL_API_KEY=replace_me_internal_key_min_16_chars
# Founder brand (R2kay Liquid Freeze) — optional for npm run brand:bootstrap-founder
# FOUNDER_BRAND_ADMIN_EMAIL=siphokwape@gmail.com
# FOUNDER_BRAND_ADMIN_PASSWORD=
# FOUNDER_BRAND_CONTACT_PHONE=0824143232
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MAIL_FROM=noreply@brand2school.co.za
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Railway Hobby: use Resend instead of SMTP (HTTPS, all plans)
# RESEND_API_KEY=re_xxxxxxxx
# Password reset: token lifetime (minutes) and max requests per user per hour
PASSWORD_RESET_EXPIRES_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=5
NOTIFICATION_DELIVERY=sync
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_POLL_MS=3000
WHATSAPP_QUEUE_POLL_MS=3000
WHATSAPP_WORKER_NAME=whatsapp-worker-1
AUDIT_EXPORT_POLL_MS=5000
ESG_REPORT_POLL_MS=60000
SMOKE_API_BASE=http://localhost:4000
SMOKE_SCHOOL_EMAIL=principal@langa.b2s.test
