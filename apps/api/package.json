{
  "name": "@brand2school/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker:audit-export": "tsx watch src/workers/auditExportWorker.ts",
    "dev:worker:whatsapp": "tsx watch src/workers/whatsappWorker.ts",
    "dev:worker:esg": "tsx watch src/workers/esgReportWorker.ts",
    "dev:worker:notifications": "tsx watch src/workers/notificationWorker.ts",
    "dev:worker:subscriptions": "tsx watch src/workers/subscriptionGovernanceWorker.ts",
    "smoke:test": "tsx scripts/smoke-test.ts",
    "prisma:generate": "npx prisma generate",
    "build": "npm run prisma:generate && npx tsc -p tsconfig.json && node scripts/copy-prisma-client.mjs",
    "build:railway": "npm run prisma:generate && npx tsc -p tsconfig.json && node scripts/copy-prisma-client.mjs",
    "start": "node dist/server.js",
    "start:worker:audit-export": "node dist/workers/auditExportWorker.js",
    "start:worker:whatsapp": "node dist/workers/whatsappWorker.js",
    "start:worker:esg": "node dist/workers/esgReportWorker.js",
    "start:worker:notifications": "node dist/workers/notificationWorker.js",
    "start:worker:subscriptions": "node dist/workers/subscriptionGovernanceWorker.js",
    "lint": "eslint \"src/**/*.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset --force",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.5.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.18.0",
    "pino": "^9.14.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "prisma": "^5.14.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
