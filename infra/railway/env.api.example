# API service — Railway variables (copy values into Railway → brand2school / api → Variables)
NODE_ENV=production
# PORT is injected by Railway — do not hardcode

# REQUIRED — Postgres → Connect → brand2school, or Variable Reference:
# DATABASE_URL=${{ Postgres.DATABASE_URL }}
# (Service name "Postgres" must match your database service on the canvas.)

JWT_ACCESS_SECRET=generate_a_long_random_string_min_32_chars
JWT_REFRESH_SECRET=generate_another_long_random_string_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Public URLs (emails, links) — canonical site is www
# Must match the hostname users visit (use https://brand2school.co.za if that is your canonical site)
WEB_APP_URL=https://brand2school.co.za
ADMIN_WEB_APP_URL=https://admin.brand2school.co.za
# Brand logos + /uploads/* asset URLs returned to browsers
API_PUBLIC_URL=https://api.brand2school.co.za

INTERNAL_API_KEY=generate_internal_key_min_32_chars
# Must match B2S_INTERNAL_API_KEY on the web service

# Meta WhatsApp Cloud API (optional until Meta app is configured — API still starts without these)
# WHATSAPP_APP_SECRET=
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Outbound email — noreply@ only (see docs/email-communication.md)
MAIL_FROM=noreply@brand2school.co.za

# Railway Hobby: SMTP ports are blocked — use Resend (HTTPS) instead:
# RESEND_API_KEY=re_xxxxxxxx
# Verify brand2school.co.za at https://resend.com/domains

# Railway Pro+: cPanel SMTP works after upgrade + redeploy:
SMTP_HOST=mail.brand2school.co.za
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@brand2school.co.za
SMTP_PASS=

# Send registration / password-reset / contact emails immediately from the API (no worker required).
# Optional worker-notifications service still helps with bulk/ESG mail.
NOTIFICATION_DELIVERY=sync

# Extra admin inboxes for school/brand registration alerts (comma-separated, optional).
# SUPER_ADMIN / ADMIN_STAFF users and admin@ / superadmin@ are always included.
# ADMIN_NOTIFY_EMAILS=ops@brand2school.co.za

LOG_LEVEL=info
