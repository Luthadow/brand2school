{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build -w @brand2school/web"
  },
  "deploy": {
    "startCommand": "npm run start -w @brand2school/web",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300
  },
  "_comment": "Set NIXPACKS_CONFIG_FILE=nixpacks.web.toml. Custom domains: www.brand2school.co.za, app.brand2school.co.za"
}
