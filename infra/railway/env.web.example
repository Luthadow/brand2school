# Web app — Railway service "web" (public site: www + app hostnames)
NODE_ENV=production
NIXPACKS_CONFIG_FILE=nixpacks.web.toml

# Browser + server-side fetches to the API (must be public HTTPS URL)
NEXT_PUBLIC_API_BASE_URL=https://api.brand2school.co.za

# Optional: canonical public site (logo URLs fall back to API base above)
# NEXT_PUBLIC_WEB_APP_URL=https://brand2school.co.za

# Server-only: must match API INTERNAL_API_KEY (live analytics / platform routes)
B2S_INTERNAL_API_KEY=same_value_as_api_INTERNAL_API_KEY
