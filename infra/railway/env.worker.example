# Workers — same secrets as API; no public domain required
NODE_ENV=production

# DATABASE_URL from Postgres plugin (reference on each worker service)

JWT_ACCESS_SECRET=same_as_api
JWT_REFRESH_SECRET=same_as_api

WEB_APP_URL=https://www.brand2school.co.za
INTERNAL_API_KEY=same_as_api

WHATSAPP_APP_SECRET=same_as_api
WHATSAPP_WEBHOOK_VERIFY_TOKEN=same_as_api
WHATSAPP_ACCESS_TOKEN=same_as_api
WHATSAPP_PHONE_NUMBER_ID=same_as_api

MAIL_FROM=noreply@brand2school.co.za
SMTP_HOST=same_as_api
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=same_as_api
SMTP_PASS=same_as_api

WHATSAPP_QUEUE_POLL_MS=3000
AUDIT_EXPORT_POLL_MS=5000
ESG_REPORT_POLL_MS=60000
NOTIFICATION_POLL_MS=3000
NOTIFICATION_BATCH_SIZE=25
NOTIFICATION_DELIVERY=queue
